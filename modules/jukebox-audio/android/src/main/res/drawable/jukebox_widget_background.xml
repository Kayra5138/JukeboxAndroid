<?xml version="1.0" encoding="utf-8"?>
<!-- The plain gradient, as WidgetGlass draws it where there is no cover: what
     the widget picker shows, and what is there for the moment before the
     first update draws the real one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
  android:shape="rectangle">
  <gradient android:angle="315" android:type="linear"
    android:startColor="#1B1F27" android:centerColor="#2A303B" android:endColor="#3A4352" />
  <corners android:radius="@dimen/jukebox_widget_radius" />
</shape>
