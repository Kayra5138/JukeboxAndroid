<?xml version="1.0" encoding="utf-8"?>
<!-- Behind the repeat button while repeat is on: a faint ring, as the player's
     own buttons are outlined when they are on. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="4dp">
  <shape android:shape="oval">
    <solid android:color="#1FFFFFFF" />
    <stroke android:width="1dp" android:color="#59FFFFFF" />
  </shape>
</inset>
