<?xml version="1.0" encoding="utf-8"?>
<!--
  Four rows of cells: the card's cover, words and buttons above, and under
  them the next few songs in the queue, each a press away from playing.

  The rows are laid out here, six of them, and shown as far as there is room
  and queue: see WidgetShape.rowsFor, which counts on the space above the
  first row adding up to LARGE_CHROME_DP. They are plain views rather than a
  collection. A collection would need a service of its own to fill it on
  Android 10 and 11 and a mutable intent for its rows, to scroll a list that
  is only ever meant to be the next few; the plain rows are drawn in the same
  update as everything else, the same on every version.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/jukebox_widget_root"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:background="@drawable/jukebox_widget_shape"
  android:clipToOutline="true"
  android:foreground="@drawable/jukebox_widget_edge">
  <ImageView android:id="@+id/jukebox_widget_glass"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:src="@drawable/jukebox_widget_background" android:scaleType="fitXY"
    android:importantForAccessibility="no" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="72dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/jukebox_widget_art"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="centerCrop"
        android:src="@drawable/jukebox_widget_cover_placeholder" />

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/jukebox_widget_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="2"
          android:text="@string/jukebox_widget_idle"
          android:textColor="#EDEDED"
          android:textSize="16sp" />

        <TextView
          android:id="@+id/jukebox_widget_artist"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="#D2D6DE"
          android:textSize="13sp" />
      </LinearLayout>
    </LinearLayout>

    <ProgressBar android:id="@+id/jukebox_widget_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent" android:layout_height="3dp"
      android:layout_marginTop="12dp"
      android:max="1000" android:progress="0"
      android:indeterminate="false" android:progressTint="#F2F2F2"
      android:progressBackgroundTint="#40FFFFFF"
      android:contentDescription="@string/jukebox_widget_progress" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:layout_marginTop="4dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageButton
        android:id="@+id/jukebox_widget_shuffle"
        android:layout_width="0dp" android:layout_height="48dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/jukebox_widget_shuffle"
        android:padding="13dp" android:scaleType="fitCenter"
        android:src="@drawable/jukebox_ic_shuffle" />

      <ImageButton
        android:id="@+id/jukebox_widget_previous"
        android:layout_width="0dp" android:layout_height="48dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/jukebox_widget_previous"
        android:padding="12dp" android:scaleType="fitCenter"
        android:src="@drawable/jukebox_ic_previous" />

      <ImageButton
        android:id="@+id/jukebox_widget_toggle"
        android:layout_width="0dp" android:layout_height="48dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/jukebox_widget_toggle"
        android:padding="9dp" android:scaleType="fitCenter"
        android:src="@drawable/jukebox_ic_play" />

      <ImageButton
        android:id="@+id/jukebox_widget_next"
        android:layout_width="0dp" android:layout_height="48dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/jukebox_widget_next"
        android:padding="12dp" android:scaleType="fitCenter"
        android:src="@drawable/jukebox_ic_next" />

      <FrameLayout
        android:layout_width="0dp" android:layout_height="48dp"
        android:layout_weight="1">
        <ImageView
          android:id="@+id/jukebox_widget_repeat_ring"
          android:layout_width="48dp" android:layout_height="48dp"
          android:layout_gravity="center"
          android:importantForAccessibility="no"
          android:src="@drawable/jukebox_widget_mode_on"
          android:visibility="gone" />
        <ImageButton
          android:id="@+id/jukebox_widget_repeat"
          android:layout_width="48dp" android:layout_height="48dp"
          android:layout_gravity="center"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:contentDescription="@string/jukebox_widget_repeat_off"
          android:padding="13dp" android:scaleType="fitCenter"
          android:src="@drawable/jukebox_ic_repeat" />
      </FrameLayout>
    </LinearLayout>

    <TextView
      android:id="@+id/jukebox_widget_up_next"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:paddingStart="6dp"
      android:paddingEnd="6dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/jukebox_widget_up_next"
      android:textAllCaps="false"
      android:textColor="#C9CED6"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/jukebox_widget_up_next_empty"
      android:layout_width="match_parent"
      android:layout_height="40dp"
      android:gravity="center_vertical"
      android:paddingStart="6dp"
      android:paddingEnd="6dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/jukebox_widget_up_next_empty"
      android:textColor="#C4C9D2"
      android:textSize="13sp" />

    <LinearLayout
      android:id="@+id/jukebox_widget_row_0"
      android:layout_width="match_parent"
      android:layout_height="40dp"
      android:background="?android:attr/selectableItemBackground"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:paddingStart="6dp"
      android:paddingEnd="6dp"
      android:visibility="gone">
      <TextView
        android:id="@+id/jukebox_widget_row_0_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1"
        android:textColor="#EDEDED" android:textSize="13sp" />
      <TextView
        android:id="@+id/jukebox_widget_row_0_artist"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1"
        android:textColor="#C9CED6" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/jukebox_widget_row_1"
      android:layout_width="match_parent"
      android:layout_height="40dp"
      android:background="?android:attr/selectableItemBackground"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:paddingStart="6dp"
      android:paddingEnd="6dp"
      android:visibility="gone">
      <TextView
        android:id="@+id/jukebox_widget_row_1_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1"
        android:textColor="#EDEDED" android:textSize="13sp" />
      <TextView
        android:id="@+id/jukebox_widget_row_1_artist"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1"
        android:textColor="#C9CED6" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/jukebox_widget_row_2"
      android:layout_width="match_parent"
      android:layout_height="40dp"
      android:background="?android:attr/selectableItemBackground"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:paddingStart="6dp"
      android:paddingEnd="6dp"
      android:visibility="gone">
      <TextView
        android:id="@+id/jukebox_widget_row_2_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1"
        android:textColor="#EDEDED" android:textSize="13sp" />
      <TextView
        android:id="@+id/jukebox_widget_row_2_artist"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1"
        android:textColor="#C9CED6" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/jukebox_widget_row_3"
      android:layout_width="match_parent"
      android:layout_height="40dp"
      android:background="?android:attr/selectableItemBackground"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:paddingStart="6dp"
      android:paddingEnd="6dp"
      android:visibility="gone">
      <TextView
        android:id="@+id/jukebox_widget_row_3_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1"
        android:textColor="#EDEDED" android:textSize="13sp" />
      <TextView
        android:id="@+id/jukebox_widget_row_3_artist"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1"
        android:textColor="#C9CED6" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/jukebox_widget_row_4"
      android:layout_width="match_parent"
      android:layout_height="40dp"
      android:background="?android:attr/selectableItemBackground"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:paddingStart="6dp"
      android:paddingEnd="6dp"
      android:visibility="gone">
      <TextView
        android:id="@+id/jukebox_widget_row_4_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1"
        android:textColor="#EDEDED" android:textSize="13sp" />
      <TextView
        android:id="@+id/jukebox_widget_row_4_artist"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1"
        android:textColor="#C9CED6" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/jukebox_widget_row_5"
      android:layout_width="match_parent"
      android:layout_height="40dp"
      android:background="?android:attr/selectableItemBackground"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:paddingStart="6dp"
      android:paddingEnd="6dp"
      android:visibility="gone">
      <TextView
        android:id="@+id/jukebox_widget_row_5_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1"
        android:textColor="#EDEDED" android:textSize="13sp" />
      <TextView
        android:id="@+id/jukebox_widget_row_5_artist"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1"
        android:textColor="#C9CED6" android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
