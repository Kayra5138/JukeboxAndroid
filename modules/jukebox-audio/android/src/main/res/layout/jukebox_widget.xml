<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/jukebox_widget_root"
  android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/jukebox_widget_glass"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:src="@drawable/jukebox_widget_background" android:scaleType="fitXY"
    android:importantForAccessibility="no" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical">
  <ImageView
    android:id="@+id/jukebox_widget_art"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:background="@drawable/jukebox_widget_art_placeholder"
    android:contentDescription="@string/jukebox_widget_art"
    android:scaleType="centerCrop" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/jukebox_widget_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#EDEDED"
      android:textSize="14sp" />

    <TextView
      android:id="@+id/jukebox_widget_artist"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:layout_marginTop="2dp"
      android:maxLines="1"
      android:textColor="#D2D6DE"
      android:textSize="12sp" />
  </LinearLayout>

  <ImageButton
    android:id="@+id/jukebox_widget_previous"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="?android:attr/selectableItemBackgroundBorderless"
    android:contentDescription="@string/jukebox_widget_previous"
    android:padding="8dp"
    android:src="@drawable/jukebox_ic_previous" />

  <ImageButton
    android:id="@+id/jukebox_widget_toggle"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:background="?android:attr/selectableItemBackgroundBorderless"
    android:contentDescription="@string/jukebox_widget_toggle"
    android:padding="8dp"
    android:src="@drawable/jukebox_ic_play" />

  <ImageButton
    android:id="@+id/jukebox_widget_next"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="?android:attr/selectableItemBackgroundBorderless"
    android:contentDescription="@string/jukebox_widget_next"
    android:padding="8dp"
    android:src="@drawable/jukebox_ic_next" />

    </LinearLayout>
    <ProgressBar android:id="@+id/jukebox_widget_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent" android:layout_height="3dp"
      android:layout_marginTop="8dp" android:max="1000" android:progress="0"
      android:indeterminate="false" android:progressTint="#F2F2F2"
      android:progressBackgroundTint="#40FFFFFF"
      android:contentDescription="@string/jukebox_widget_progress" />
  </LinearLayout>
</FrameLayout>
