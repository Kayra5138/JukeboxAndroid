<?xml version="1.0" encoding="utf-8"?>
<!-- Playback events refresh the widget; the running service updates progress
     once per second only while playing, the screen is on and a widget exists. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:description="@string/jukebox_widget_description"
  android:initialLayout="@layout/jukebox_widget"
  android:minWidth="250dp"
  android:minHeight="92dp"
  android:previewLayout="@layout/jukebox_widget"
  android:resizeMode="horizontal"
  android:targetCellWidth="4"
  android:targetCellHeight="1"
  android:updatePeriodMillis="0"
  android:widgetCategory="home_screen" />
