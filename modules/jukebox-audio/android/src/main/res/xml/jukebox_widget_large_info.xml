<?xml version="1.0" encoding="utf-8"?>
<!-- The now-playing widget at four rows of cells, with the next few songs of
     the queue under the controls. The same widget as the other two, offered
     at this size of its own; see jukebox_widget_card_info.xml. Two hundred
     and fifty is four rows by (height + 30) / 70. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:description="@string/jukebox_widget_large_description"
  android:initialLayout="@layout/jukebox_widget_large"
  android:minWidth="250dp"
  android:minHeight="250dp"
  android:minResizeHeight="40dp"
  android:previewLayout="@layout/jukebox_widget_large"
  android:previewImage="@drawable/jukebox_widget_preview_large"
  android:resizeMode="horizontal|vertical"
  android:targetCellWidth="4"
  android:targetCellHeight="4"
  android:updatePeriodMillis="0"
  android:widgetCategory="home_screen" />
