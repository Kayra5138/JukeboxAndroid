  <string name="jukebox_widget_shuffle">Shuffle the queue</string>
  <string name="jukebox_widget_repeat_off">Repeat</string>
  <string name="jukebox_widget_repeat_all">Repeat all</string>
  <string name="jukebox_widget_repeat_one">Repeat one</string>
  <!-- Over the songs the large widget lists, and in their place when there are none. -->
  <string name="jukebox_widget_up_next">Up next</string>
  <string name="jukebox_widget_up_next_empty">Nothing up next</string>
