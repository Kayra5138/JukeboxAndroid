<?xml version="1.0" encoding="utf-8"?>
<resources>
  <string name="jukebox_widget_label" translatable="false">Jukebox</string>
  <string name="jukebox_widget_description">Play, pause and skip without opening the app.</string>
  <string name="jukebox_widget_art">Album art</string>
  <string name="jukebox_widget_previous">Previous track</string>
  <string name="jukebox_widget_toggle">Play or pause</string>
  <!-- What the middle button is called to a screen reader: what a press will do, as its picture says. -->
  <string name="jukebox_widget_play">Play</string>
  <string name="jukebox_widget_pause">Pause</string>
  <string name="jukebox_widget_next">Next track</string>
  <string name="jukebox_widget_idle">Nothing playing</string>
  <string name="jukebox_widget_progress">Song progress</string>
  <!-- The larger widgets: what the picker calls them and says of them. -->
  <string name="jukebox_widget_card_label">Now playing</string>
  <string name="jukebox_widget_card_description">A large cover with the controls, shuffle and repeat.</string>
  <string name="jukebox_widget_large_label">Up next</string>
  <string name="jukebox_widget_large_description">What is playing, the controls, and the next songs in the queue. Tap one to play it.</string>
  <string name="jukebox_widget_shortcut_label">Shuffle</string>
  <string name="jukebox_widget_shortcut_description">Shuffle all your music, or what you played recently, in one tap.</string>
